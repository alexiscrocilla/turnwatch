{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Session Monitor",
  "version": "0.1.0",
  "identifier": "local.claude-session-monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sessions Claude",
        "width": 380,
        "height": 560,
        "minWidth": 300,
        "minHeight": 44,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "shadow": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alexis Crocilla",
    "copyright": "Alexis Crocilla",
    "shortDescription": "État en direct des sessions Claude Code de Claude Desktop",
    "resources": {
      "../mod/.claude-plugin/marketplace.json": "companion/.claude-plugin/marketplace.json",
      "../mod/monitor-compagnon/.claude-plugin/plugin.json": "companion/monitor-compagnon/.claude-plugin/plugin.json",
      "../mod/monitor-compagnon/hooks/*": "companion/monitor-compagnon/hooks/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
