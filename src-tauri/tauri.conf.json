{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turnwatch",
  "version": "0.2.0",
  "identifier": "local.turnwatch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Turnwatch",
        "width": 380,
        "height": 560,
        "minWidth": 300,
        "minHeight": 44,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "shadow": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alexis Crocilla",
    "copyright": "Alexis Crocilla",
    "shortDescription": "Live status of the Claude Code sessions in Claude Desktop",
    "resources": {
      "../mod/.claude-plugin/marketplace.json": "companion/.claude-plugin/marketplace.json",
      "../mod/turnwatch-companion/.claude-plugin/plugin.json": "companion/turnwatch-companion/.claude-plugin/plugin.json",
      "../mod/turnwatch-companion/hooks/*": "companion/turnwatch-companion/hooks/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "French"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCNjNCQ0VFNDMxNEM5M0EKUldRNnlSUkQ3cnhqbXlXL1g5T1ZjVWtvc25pNFo3UzFVTTZJUis3Wjd0Nm1BWEJ2TFVlbkJKOTUK",
      "endpoints": ["https://github.com/alexiscrocilla/turnwatch/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  }
}
